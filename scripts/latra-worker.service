[Unit]
Description=LATRA-Wialon scheduler worker
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/lampp/htdocs/latra-wialon-integration
ExecStart=/opt/lampp/bin/php /opt/lampp/htdocs/latra-wialon-integration/bin/worker.php
Restart=always
RestartSec=3
User=daemon

[Install]
WantedBy=multi-user.target
