parameters:
	ignoreErrors:
		-
			message: '#^Constant APP_ENV not found\.$#'
			identifier: constant.notFound
			count: 1
			path: api.php

		-
			message: '#^While loop condition is always true\.$#'
			identifier: while.alwaysTrue
			count: 1
			path: bin/worker.php

		-
			message: '#^Constant WIALON_BASE_URL not found\.$#'
			identifier: constant.notFound
			count: 1
			path: includes/FleetSync.php

		-
			message: '#^Constant WIALON_TOKEN not found\.$#'
			identifier: constant.notFound
			count: 1
			path: includes/FleetSync.php

		-
			message: '#^Anonymous function with return type void returns null but should not return anything\.$#'
			identifier: return.void
			count: 2
			path: includes/RelayRuntime.php

		-
			message: '#^Constant WIALON_BASE_URL not found\.$#'
			identifier: constant.notFound
			count: 1
			path: includes/WialonAPI.php

		-
			message: '#^Constant WIALON_TOKEN not found\.$#'
			identifier: constant.notFound
			count: 1
			path: includes/WialonAPI.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Application/Collection/RelayPayloadMapper.php

		-
			message: '#^Call to function in_array\(\) with arguments 0, array\{5, 7\} and true will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Domain/Ingestion/ActivityDetectionPolicy.php

		-
			message: '#^Offset ''activity_id'' on null on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Domain/Ingestion/ActivityDetectionPolicy.php
